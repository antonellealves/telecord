{
  "name": "@telecord/api",
  "version": "0.0.0",
  "private": true,
  "type": "commonjs",
  "main": "dist/src/main.js",
  "exports": {
    "./vercel": "./dist/src/vercel.js"
  },
  "scripts": {
    "build": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\" && prisma generate && tsc --project tsconfig.json && node -e \"require('fs').writeFileSync('dist/package.json','{ \\\"type\\\": \\\"commonjs\\\" }\\n')\"",
    "start": "node dist/src/main.js",
    "dev": "tsc --project tsconfig.json --watch",
    "typecheck": "tsc --project tsconfig.json --noEmit",
    "test": "node --test \"dist/test/**/*.test.js\"",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate deploy",
    "prisma:seed": "node prisma/seed.mjs"
  },
  "dependencies": {
    "@nestjs/common": "^10.4.0",
    "@nestjs/config": "^3.3.0",
    "@nestjs/core": "^10.4.0",
    "@nestjs/platform-express": "^10.4.0",
    "@nestjs/throttler": "^6.3.0",
    "@prisma/client": "^6.2.0",
    "@telecord/shared": "workspace:*",
    "cookie": "^1.0.2",
    "jose": "^5.9.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.0",
    "prisma": "^6.2.0",
    "typescript": "^5.7.0"
  }
}
