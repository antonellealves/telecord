{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "installCommand": "pnpm install --frozen-lockfile",
  "buildCommand": "pnpm run build",
  "outputDirectory": "apps/web/dist",
  "git": {
    "deploymentEnabled": false
  },
  "functions": {
    "api/*.ts": {
      "maxDuration": 30,
      "includeFiles": "api-bundle/**"
    }
  },
  "rewrites": [
    {
      "source": "/api/token",
      "destination": "/api/token"
    },
    {
      "source": "/api/rooms",
      "destination": "/api/rooms"
    },
    {
      "source": "/api/:path*",
      "destination": "/api/[...nest]"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/api/((?!sounds/).*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    }
  ]
}
