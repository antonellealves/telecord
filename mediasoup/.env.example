# Copie para .env NESTA PASTA na VM (mediasoup/.env dentro do checkout do
# repo, ver .github/workflows/deploy.yml), ao lado do docker-compose.prod.yml.
# Não é o mesmo .env do monorepo — este só serve ao processo mediasoup-sfu
# rodando sozinho na VM.

# Segredo compartilhado com `apps/api` (variável MEDIASOUP_INTERNAL_SECRET no
# .env do monorepo/Vercel) — autentica a chamada servidor-servidor entre o
# proxy /api/mediasoup/* e este processo. Gere qualquer string aleatória
# longa, ex.: `openssl rand -hex 32`.
MEDIASOUP_INTERNAL_SECRET=

# IP PÚBLICO desta VM (o mesmo que já vai em LIVEKIT_NODE_IP no .env do
# livekit/) — o mediasoup anuncia isto nos candidatos ICE para a mídia
# conectar de verdade, mesma necessidade do LiveKit.
MEDIASOUP_ANNOUNCED_IP=
