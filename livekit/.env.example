# Copie para .env NESTA PASTA na VM (livekit/.env), ao lado do
# docker-compose.prod.yml. Não é o mesmo .env do monorepo — este só serve ao
# servidor LiveKit rodando sozinho na VM.

# MESMO par que apps/api usa para emitir (api/token.ts) e conferir
# (apps/api/src/livekit/webhook-auth.ts) token — gere com
# `node scripts/gen-livekit-keys.mjs` no seu computador e copie os dois
# valores para cá (e para os secrets do GitHub Actions e da Vercel).
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Rota do webhook na API de produção (Vercel). Troque pelo domínio real se
# mudar; é a MESMA rota que já existe para o LiveKit Cloud.
LIVEKIT_WEBHOOK_URL=https://telecord.vercel.app/api/livekit/webhook

# IP PÚBLICO desta VM (não o IP interno/privado da rede da Oracle) — o
# LiveKit anuncia isto nos candidatos ICE para a mídia conectar de verdade.
LIVEKIT_NODE_IP=

# Host público para o TLS automático (Caddy + Let's Encrypt). Sem domínio
# próprio, use nip.io: troque os pontos do IP por hífen e acrescente
# ".nip.io" — ex.: IP 129.1.2.3 vira "129-1-2-3.nip.io". Resolve sozinho
# para o próprio IP, então o desafio HTTP-01 do Let's Encrypt funciona sem
# nenhum DNS configurado à mão.
LIVEKIT_PUBLIC_HOST=
