# Copie para .env NESTA PASTA na VM (/opt/telecord-proxy/.env), ao lado do
# docker-compose.proxy.yml.
#
# Dois hosts nip.io DISTINTOS, resolvendo para o MESMO IP público da VM —
# nip.io não liga para o texto antes do IP, só para o IP embutido no nome, e
# o Caddy usa o hostname da requisição para decidir para qual serviço
# encaminhar (ver Caddyfile). Precisam ser diferentes um do outro: dois sites
# no mesmo Caddy não podem responder pelo mesmo host.

# MESMO valor de LIVEKIT_PUBLIC_HOST no .env de livekit/.
LIVEKIT_PUBLIC_HOST=

# Sugestão: prefixe algo antes do IP, ex.: IP 129.1.2.3 vira
# "ms-129-1-2-3.nip.io" (o LiveKit já usa "129-1-2-3.nip.io" sem prefixo).
MEDIASOUP_PUBLIC_HOST=
