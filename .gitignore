node_modules/
dist/
*.tsbuildinfo

# O project.json é versionado de propósito: orgId e projectId são
# identificadores, não credenciais. Com ele no repo, a CLI já sabe em qual
# projeto está operando e o CI só precisa do token.
.vercel/*
!.vercel/project.json

# Segredos: só o .env.example é versionado.
.env
.env.*
!.env.example

# O seed carrega o e-mail e a SENHA da primeira conta administradora, então
# ele é tratado como o .env: fica só na máquina de quem roda. O que se versiona
# é o modelo, para a FORMA do seed continuar revisável sem os valores.
apps/api/prisma/seed.mjs

.DS_Store
*.log

# Cliente do Prisma gerado dentro do serviço (ver o `output` no schema).
# Sai do `prisma generate`, que roda no build — aqui e na Vercel.
apps/api/src/generated/

# Saída de `scripts/bundle-api.mjs`: o serviço empacotado e o cliente do
# Prisma ao lado dele, ambos gerados no build.
api-bundle/

